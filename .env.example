# ─────────────────────────────────────────────────────────────────────────────
# Drawing Room — environment template
#
#   cp .env.example .env     then fill in only the sections you actually need.
#
# .env is gitignored; .env.example is committed. Never put a real key in here.
# Everything below is loaded by `dotenv` (Node: orchestrator/lib/env.js,
# Python: config.py). Anything marked OPTIONAL has a working default in code —
# leave it unset unless you have a reason.
#
# Nothing here is needed just to read the repo, run `npm run lint`, or run
# `npm run eval:skills`. Keys cost money; add them a section at a time.
# ─────────────────────────────────────────────────────────────────────────────


# ═══ 1. MODEL CREDENTIAL — needed by every thinking stage ═════════════════════
# Scripting, QA and the judge stages call a Claude model. Set exactly ONE of
# these. The value must start with "sk-ant-" — /health shape-checks it, because
# pasting this project's own cq_... token here once made /health go green while
# every run still died in `research`.
#
# CLAUDE_CODE_OAUTH_TOKEN uses the Claude Code subscription (`claude -p`) and is
# what the live service runs on. ANTHROPIC_API_KEY is metered per token.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-...
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_AUTH_TOKEN=sk-ant-...        # third alias; rarely the right choice


# ═══ 2. EXPLAINER VIDEO PIPELINE (the default pipeline) ═══════════════════════
# Google AI Studio key — Imagen art generation AND Gemini TTS voiceover.
# This is the one key you cannot make a video without.
# The pipeline accepts either name; GEMINI_API_KEY wins if both are set.
GEMINI_API_KEY=
# GOOGLE_STUDIO_API_KEY=                 # legacy alias, same key

# Paid art/TTS calls REFUSE to run unless this run is confirmed. Prefer passing
# `--yes` on the command line per run over setting this to 1 in .env — a stray
# 1 here removes the only guard against an unattended spend.
# CONFIRM_SPEND=0

# OPTIONAL model/voice overrides — defaults live in the pipeline config.
# GEMINI_IMAGE_MODEL=
# GEMINI_TTS_MODEL=
# TTS_VOICE=
# JUDGE_MODEL=
# ART_JUDGE_MODEL=
# RENDER_WORKERS=                        # parallel Puppeteer renders


# ═══ 3. KIE.AI — avatar lip-sync + image-to-video motion (OPTIONAL) ═══════════
# Only for `creating-avatar-videos` and i2v motion beats. The standard explainer
# pipeline does not touch these. GEMINI_OMNI_API_KEY is the funded account and
# is tried first; KIE_API_KEY is the fallback.
# GEMINI_OMNI_API_KEY=
# KIE_API_KEY=
# OMNI_MODEL=
# LIPSYNC_MODEL=
# I2V_MODEL=


# ═══ 4. THE LIVE SERVICE (server/index.js — skip for local video work) ════════
# PORT=8080

# Bearer token for the Content API. Without this AND without TENANTS_JSON the
# data routes answer 503 — they fail closed rather than serving openly.
CONTENT_API_TOKEN=
# TENANTS_JSON=[]                        # JSON array of tenant objects
# TENANT_TOKEN_PEPPER=                   # else a random one per boot: tokens
#                                        # stop matching across restarts
# CONTENT_API_ORIGINS=                   # comma-separated CORS allowlist

# Signs the owner cookie. Unset means a fresh random secret every boot, which
# logs everyone out on each deploy. Set it in production.
# OWNER_COOKIE_SECRET=
# OWNER_COOKIE_SECRET_PREVIOUS=          # set during a rotation, then remove

# Guards the manual /tick endpoint so strangers cannot trigger the loop.
# TICK_SECRET=
# TICK_INTERVAL_MS=120000                # 0 disables the background loop

# Job store. JOB_STORE_DIR on the Railway volume + JOB_STORE_DURABLE=1 is what
# makes jobs survive a restart; without it they live in the container only.
# JOB_STORE_DIR=
# JOB_STORE_DURABLE=0
# JOB_STORE_SWEEP_MS=3600000

# Outbound webhooks (OPTIONAL).
# WEBHOOK_SIGNING_SECRET=
# WEBHOOK_ALLOWED_HOSTS=                 # comma-separated; empty = none allowed
# WEBHOOK_ALLOWED_PORTS=443,80
# WEBHOOK_ALLOW_HTTP=0
# WEBHOOK_MAX_ATTEMPTS=3
# WEBHOOK_TIMEOUT_MS=5000


# ═══ 5. SPEND CONTROLS ════════════════════════════════════════════════════════
# `produce` refuses to spend on art and TTS without a pre-authorised budget, so
# this is 0 (= refuse everything) until someone sets it deliberately.
# PIPELINE_BUDGET_USD=0
# PIPELINE_MAX_APPROVABLE_USD=10         # hard wall; approval cannot exceed it
# PIPELINE_ASK_ABOVE_BUDGET=1            # 0 = refuse outright instead of asking
# PIPELINE_DRY_RUN=0                     # 1 = walk the chain, spend nothing
# PIPELINE_STOP_AFTER=qa                 # where a single video stops
# PIPELINE_COURSE_STOP_AFTER=upload      # where a course build stops
# PIPELINE_COURSE_LESSON_RESERVE_USD=2.5
# PIPELINE_MAX_RUN_MINUTES=
# DEFAULT_SERIES=                        # blank on purpose: guessing files a
#                                        # video under the wrong series


# ═══ 6. SLACK (OPTIONAL — the bot surface) ════════════════════════════════════
# SLACK_BOT_TOKEN=xoxb-...               # posting
# SLACK_USER_TOKEN=xoxp-...              # polling: search.messages is not
#                                        # available to bot tokens
# SLACK_SIGNING_SECRET=
# SLACK_DEFAULT_CHANNEL=
# SLACK_BOT_USER_ID=


# ═══ 7. NOTION (OPTIONAL — work tracking) ═════════════════════════════════════
# Both are needed together; either alone reports not-ready on /health.
# NOTION_API_KEY=
# NOTION_DATABASE_ID=


# ═══ 8. GOOGLE DRIVE — finished videos are offloaded here (OPTIONAL) ══════════
# Destination folder. Without it there is nowhere to upload to.
# GDRIVE_FOLDER_ID=
#
# Auth, in the order the code tries it:
#   a) service account (preferred — how the TU account authenticates)
# GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY_JSON=   # the whole JSON key, inline
# GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY_PATH=   # or a path to the key file
#   b) OAuth fallback. Run `node orchestrator/gdrive-auth.js` once locally,
#      signed in as the Taleemabad University account, then put the printed
#      refresh token here. Falls back to the YOUTUBE_* client if unset.
# GDRIVE_CLIENT_ID=
# GDRIVE_CLIENT_SECRET=
# GDRIVE_REFRESH_TOKEN=


# ═══ 9. YOUTUBE PUBLISHING (OPTIONAL) ═════════════════════════════════════════
# Scoped to youtube.upload alone — this token can never write to Drive.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=


# ═══ 10. LEGACY PYTHON PIPELINE (config.py) ═══════════════════════════════════
# Only if you are maintaining pre-explainer content. New work needs none of it.
# OPENAI_API_KEY=                        # Whisper transcription
# LMS_API_KEY=
# LMS_BASE_URL=https://api.taleemabad.com
# ELEVENLABS_API_KEY=                    # LEGACY. Never use without Aroma's
#                                        # explicit permission (see CLAUDE.md)
# ASSEMBLYAI_API_KEY=
# RUNWAY_API_KEY=
# ROEX_API_KEY=
# JSON2VIDEO_API_KEY=
# VIZARD_API_KEY=
# YOUTUBE_API_KEY=
# REPLICATE_API_KEY=


# ═══ 11. SET BY THE DOCKER IMAGE — do NOT put these in .env ═══════════════════
# The Dockerfile pins these and the regression tests assert on them. Set them
# locally only if a preflight check tells you a binary cannot be found.
#   PUPPETEER_EXECUTABLE_PATH   the Chromium Puppeteer launches (it does NOT
#                               read CHROME_PATH — that is a Lighthouse name)
#   FFMPEG_BIN                  defaults to `ffmpeg` on PATH
#   RAILWAY_*                   injected by Railway at runtime
#
# Likewise, per-run knobs (LESSON_NAME, ART_IDS, SEG_IDS, BRAND_DIR, MUSIC_FILE,
# SAMPLE_IDS, ANIMATE_ALL …) are passed on the command line for one invocation.
# They do not belong in .env.
