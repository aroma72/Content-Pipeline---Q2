+  it('never throws on a malformed plan', () => {
+    expect(motionPlanErrors(null)).toEqual([]);
+    expect(motionPlanErrors({ modules: [null, { lessons: 'x' }] })).toEqual([]);
+  });
+});
+
+describe('style on the wire', () => {
+  const plan: CoursePlan = {
+    title: 't', style: 'motion-graphics',
+    modules: [{ title: 'm', lessons: [{ title: 'A', slo: 's', brief: 'b', difficulty: 'novice' }] }],
+  };
+
+  it('build sends the style it is given', async () => {
+    fetchMock.mockResolvedValue(jsonResponse({ courseId: 'course-x1', items: ['a'], rejected: [] }, 202));
