+      slo: string;
+      /** motion-graphics only: at least one, with a name. */
+      models?: { name: string; author?: string; summary?: string }[];
+      /** motion-graphics only: at least two, each with a situation. */
+      walkthroughs?: { title?: string; situation: string }[];
