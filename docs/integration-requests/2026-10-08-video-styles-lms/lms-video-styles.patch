+});
+
+describe('motionPlanErrors', () => {
+  it('reports their path for each missing field', () => {
+    const plan = {
+      title: 't',
+      modules: [{ title: 'm', lessons: [{ title: 'A', slo: 's', brief: 'b', difficulty: 'novice' }] }],
+    } as CoursePlan;
+    expect(motionPlanErrors(plan).map((p) => p.path)).toEqual([
