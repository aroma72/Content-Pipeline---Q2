+// ─── Draft teaching (motion-graphics) ────────────────────────────────────────────────────────────
+
+/** Their per-request cap. More is a 400 on their side; refused here first, for free. */
+export const DRAFT_MAX_LESSONS = 30;
+
+/**
+ * A model call of 20-40 s. Same reasoning as PLAN_TIMEOUT_MS, scaled: hanging up early throws away
+ * a paid answer their side finishes anyway, so the bound is generous (~3x the slow end).
+ */
+const DRAFT_TIMEOUT_MS = 120_000;
+
+export interface DraftTeachingRequest {
+  topic?: string;
+  audience?: string;
+  /** In course order. Their answer comes back in the same order, one for one. */
+  lessons: { title: string; slo: string }[];
+}
+
+export interface DraftedLesson {
+  /** 0-based, the position in the request. */
+  index: number;
+  title: string;
+  sloIds: string[];
+  models: PlannedModel[];
+  walkthroughs: PlannedWalkthrough[];
+}
+
+export interface TeachingDraft {
+  slos: PlannedSlo[];
+  lessons: DraftedLesson[];
+  draftedAt: string | null;
+}
+
+/**
+ * Validate a request body for draft-teaching. Pure, so the route and its test share it.
+ * Every lesson needs both a title and an SLO — their 400 for the same rule, said in our words.
+ */
+export function parseDraftTeachingBody(
+  body: unknown,
+): { ok: true; req: DraftTeachingRequest } | { ok: false; detail: string } {
+  const b = (body ?? {}) as Record<string, unknown>;
+  const raw = Array.isArray(b.lessons) ? b.lessons : null;
+  if (!raw || raw.length === 0) return { ok: false, detail: 'Add at least one video, with its title and SLO, before drafting.' };
+  if (raw.length > DRAFT_MAX_LESSONS) {
+    return { ok: false, detail: `Drafting works on up to ${DRAFT_MAX_LESSONS} videos at a time; this course has ${raw.length}.` };
+  }
+  const lessons: { title: string; slo: string }[] = [];
+  for (const [i, l] of raw.entries()) {
+    const o = (l ?? {}) as Record<string, unknown>;
+    const title = cleanText(o.title, 300);
+    const slo = cleanText(o.slo, 1000);
+    if (!title || !slo) return { ok: false, detail: `Video ${i + 1} needs a title and an SLO before it can be drafted.` };
+    if (containsCourseTag(title) || containsCourseTag(slo)) {
+      return { ok: false, detail: `Video ${i + 1} contains a course tag in its text.` };
+    }
+    lessons.push({ title, slo });
+  }
+  const topic = cleanText(b.topic, 300);
+  const audience = cleanText(b.audience, 300);
+  return { ok: true, req: { ...(topic ? { topic } : {}), ...(audience ? { audience } : {}), lessons } };
+}
+
+/**
+ * Normalise their draft. Field by field like every other payload, and checked to be ONE FOR ONE
+ * with what we sent — their contract says lessons are never merged or dropped, and a draft that
+ * lands on the wrong lesson is worse than no draft, so a count or index mismatch is refused.
+ * Exported for its test.
+ */
+export function normaliseTeachingDraft(raw: unknown, sent: number): TeachingDraft | null {
+  if (!raw || typeof raw !== 'object') return null;
+  const body = raw as Record<string, unknown>;
+  if (!Array.isArray(body.lessons) || body.lessons.length !== sent) return null;
+  const lessons: DraftedLesson[] = [];
