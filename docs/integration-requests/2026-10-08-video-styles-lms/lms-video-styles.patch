+    expect(list.styles[0]!.writingStyle).toEqual({ narrator: 'A warm mentor', voice: 'Aoede', rules: ['r1'], sample: [{ line: 'l1' }] });
+    expect(list.styles[1]!.writingStyle!.sample).toEqual([{ line: 'You are a buddy.', read: 'with a smile' }]);
+  });
