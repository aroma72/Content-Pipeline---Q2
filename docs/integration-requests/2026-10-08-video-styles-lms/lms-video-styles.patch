+    for (const raw of [undefined, null, '']) {
+      expect(parseStyleInput(raw)).toEqual({ ok: true, style: 'character-arc' });
+    }
+  });
+
+  it('accepts both known ids and refuses anything else with a sentence', () => {
+    expect(parseStyleInput('motion-graphics')).toEqual({ ok: true, style: 'motion-graphics' });
+    const bad = parseStyleInput('claymation');
