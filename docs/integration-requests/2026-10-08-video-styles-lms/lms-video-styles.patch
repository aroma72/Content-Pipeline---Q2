+      sloIds?: string[];
+    }[];
+  }[];
+  /** motion-graphics only: the course's numbered SLOs, as drafted and edited. */
+  slos?: { id: string; text: string }[];
+  /**
+   * The video style every lesson is made in — an id from GET /api/content-courses/styles. Fixed
+   * for the course once planned. Absent is `character-arc`.
+   */
+  style?: string;
+}
+
+/**
+ * Drafting is one model call on Content Automation's side, measured at 20-40 s — past apiRequest's
+ * 25 s default, so it carries its own bound for the same reason as the plan: hanging up early
+ * throws away an answer their side finishes anyway. 150 s sits above the API's own 120 s.
+ */
+export const DRAFT_CLIENT_TIMEOUT_MS = 150_000;
+
+export interface DraftTeachingRequest {
+  topic?: string;
+  audience?: string;
+  /** Every video's title and SLO, in course order. */
+  lessons: { title: string; slo: string }[];
+}
+
+/**
+ * POST /api/content-courses/draft-teaching — free. Drafts each motion-graphics video's model and
+ * walk-throughs, and the course SLOs, for the instructor to edit. Nothing is stored.
+ */
+export async function draftTeaching<T>(body: DraftTeachingRequest): Promise<T> {
+  return apiRequest<T>('/api/content-courses/draft-teaching', {
+    method: 'POST',
+    body: JSON.stringify(body),
+    signal: AbortSignal.timeout(DRAFT_CLIENT_TIMEOUT_MS),
+  });
 }
 
