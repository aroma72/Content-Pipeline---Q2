index 0000000..cf78190
--- /dev/null
+++ b/apps/web/src/lib/video-styles.ts
@@ -0,0 +1,158 @@
+/**
+ * Video styles (Content Automation, 2026-10-08) — the pure half, so a test can reach it.
+ *
+ * A course or a single video is made in ONE style, picked where the topic is typed:
+ *   character-arc   — the illustrated story about Ali. The default, and what everything made
+ *                     before today was.
+ *   motion-graphics — flat motion graphics spoken to "you". Every video is BUILT from at least one
+ *                     named model and at least two walk-throughs; their build refuses one without.
+ *
+ * The list itself (labels, previews, prices, how the script sounds) comes from the API — never
+ * written into a page — because it is theirs to change. Only the two ids, and the motion rule,
+ * live here, and the server checks both again.
+ *
+ * Node-environment vitest, no DOM (see apps/web/vitest.config.ts) — keep this file free of React.
+ */
+import { apiRequest } from './api';
+
+export interface WritingStyleSample {
+  line: string;
+  /** motion-graphics only: how the line is read. Shown small and italic. */
+  read?: string;
+}
+
+export interface WritingStyle {
+  narrator: string;
+  voice: string;
+  rules: string[];
+  sample: WritingStyleSample[];
+}
+
+export interface VideoStyleInfo {
+  id: string;
+  label: string;
+  default: boolean;
+  summary: string;
+  bestFor: string;
+  previewUrl: string | null;
+  previewSeconds: number | null;
+  /** THEIR estimate. Our own charge per video comes from /spend and is what the confirm shows. */
+  estimatedCostPerLessonUsd: number | null;
+  writingStyle: WritingStyle | null;
+}
+
+export interface StylesResponse {
+  default: string;
+  styles: VideoStyleInfo[];
+}
+
+export const DEFAULT_STYLE = 'character-arc';
+export const MOTION_STYLE = 'motion-graphics';
+
+/** Labels for showing a stored style without fetching the list (badges, old rows). */
+const KNOWN_LABELS: Record<string, string> = {
+  'character-arc': 'Character Arc',
+  'motion-graphics': 'Flat Motion Graphics',
+};
+
+export function styleLabel(id: string | null | undefined, list?: VideoStyleInfo[] | null): string {
+  const key = id || DEFAULT_STYLE;
+  return list?.find((s) => s.id === key)?.label ?? KNOWN_LABELS[key] ?? key;
+}
+
+export function isMotion(id: string | null | undefined): boolean {
+  return id === MOTION_STYLE;
+}
+
+/** The style a fresh form starts on: the one the list marks default, else ours. */
+export function initialStyle(res: StylesResponse | null): string {
+  if (!res || res.styles.length === 0) return DEFAULT_STYLE;
+  return res.styles.find((s) => s.id === res.default)?.id
+    ?? res.styles.find((s) => s.default)?.id
+    ?? res.styles[0]!.id;
+}
+
+/**
+ * GET the list through our API — `/api/content-courses/styles` or `/api/content-videos/styles`,
+ * whichever router the form already has permission on. Same answer from both.
+ */
+export function loadStyles(from: 'courses' | 'videos'): Promise<StylesResponse> {
+  return apiRequest<StylesResponse>(from === 'courses' ? '/api/content-courses/styles' : '/api/content-videos/styles');
+}
+
+// ─── The motion-graphics fields on one authored video ───────────────────────────────────────────
+
+export interface ModelRow { name: string; author: string; summary: string }
+export interface WalkthroughRow { title: string; situation: string }
+
+export interface MotionFields {
+  models: ModelRow[];
+  walkthroughs: WalkthroughRow[];
+}
+
+/** Their minimum is one model and two walk-throughs, so a new video starts with exactly those rows. */
+export function emptyMotionFields(): MotionFields {
+  return {
+    models: [{ name: '', author: '', summary: '' }],
+    walkthroughs: [{ title: '', situation: '' }, { title: '', situation: '' }],
+  };
+}
+
+/**
+ * What a motion video still needs, as short phrases ("a model", "a second walk-through").
+ * Empty means it can be sent. The server and their build apply the same rule.
+ */
+export function motionGaps(v: Partial<MotionFields> | null | undefined): string[] {
+  const gaps: string[] = [];
+  const models = v?.models ?? [];
+  const walks = v?.walkthroughs ?? [];
+  if (!models.some((m) => m.name.trim())) gaps.push('a model');
+  const situated = walks.filter((w) => w.situation.trim()).length;
+  if (situated === 0) gaps.push('two walk-throughs');
+  else if (situated === 1) gaps.push('a second walk-through');
+  return gaps;
+}
+
+/** What is sent for one video: blank rows dropped, so the server sees only what was written. */
+export function motionPayload(v: MotionFields): {
+  models: { name: string; author?: string; summary?: string }[];
+  walkthroughs: { title?: string; situation: string }[];
+} {
+  return {
+    models: v.models
+      .filter((m) => m.name.trim())
+      .map((m) => ({
+        name: m.name.trim(),
+        ...(m.author.trim() ? { author: m.author.trim() } : {}),
+        ...(m.summary.trim() ? { summary: m.summary.trim() } : {}),
+      })),
+    walkthroughs: v.walkthroughs
+      .filter((w) => w.situation.trim())
+      .map((w) => ({ ...(w.title.trim() ? { title: w.title.trim() } : {}), situation: w.situation.trim() })),
+  };
+}
+
+// ─── Reading a stored plan back (resume, the course page) ───────────────────────────────────────
+
+export interface PlanMotionLesson {
+  sloIds?: string[];
+  models?: { name: string; author?: string; summary?: string }[];
+  walkthroughs?: { title?: string; situation: string }[];
+}
+
+/** A stored plan lesson's motion fields, as form rows. Missing becomes the empty minimum. */
+export function motionFieldsFromPlan(l: PlanMotionLesson | null | undefined): MotionFields {
+  const models = (l?.models ?? []).map((m) => ({ name: m.name ?? '', author: m.author ?? '', summary: m.summary ?? '' }));
+  const walkthroughs = (l?.walkthroughs ?? []).map((w) => ({ title: w.title ?? '', situation: w.situation ?? '' }));
+  const empty = emptyMotionFields();
+  return {
+    models: models.length > 0 ? models : empty.models,
+    walkthroughs: walkthroughs.length >= 2 ? walkthroughs : [...walkthroughs, ...empty.walkthroughs].slice(0, 2),
+  };
+}
+
+/** "$1.50 per video" — their estimate, worded as one. */
+export function costPerVideoText(usd: number | null | undefined): string | null {
+  if (typeof usd !== 'number' || !Number.isFinite(usd)) return null;
+  return `about $${usd.toFixed(2)} per video`;
+}
