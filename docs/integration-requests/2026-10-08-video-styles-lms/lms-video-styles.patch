+/**
+ * Unit — Content Automation video styles (contract 1.2, additive, 2026-10-08).
+ *
+ * Three things are pinned here, each because getting it wrong costs money or misfiles a course:
+ *
+ *   1. `style` is ALWAYS sent on plan, build and make-video — never left to their default.
+ *   2. A motion-graphics plan without a model and two walk-throughs per lesson is refused on OUR
+ *      side before anything is written (authored) or charged (build), with the lesson named.
+ *   3. Their `400 invalid_plan` / `invalid_style` on build is `invalid` — the reversible reason —
+ *      and carries their per-lesson messages, not just their summary sentence.
+ *
+ * `fetch` is mocked rather than the modules, as in content-queen-courses.test.ts.
+ */
+import { describe, it, expect, beforeEach, afterEach, vi } from 'vitest';
+import {
+  parseStyleInput,
+  normaliseStyleList,
+  motionPlanErrors,
+  getStyles,
+  resetStylesCache,
+} from '../../src/lib/content-queen-styles.js';
+import { buildAuthoredPlan, buildCourse, lessonsOf, type CoursePlan } from '../../src/lib/content-queen-courses.js';
+import { createJob } from '../../src/lib/content-queen-jobs.js';
+
+function jsonResponse(body: unknown, status = 200) {
+  return { ok: status >= 200 && status < 300, status, json: async () => body } as unknown as Response;
+}
+
+let fetchMock: ReturnType<typeof vi.fn>;
+
+beforeEach(() => {
+  process.env.CONTENT_QUEEN_API_TOKEN = 'test-token-not-a-real-credential';
+  process.env.CONTENT_QUEEN_JOBS_ENABLED = 'true';
+  process.env.CONTENT_QUEEN_PRODUCE_ENABLED = 'true';
+  process.env.CONTENT_QUEEN_API_URL = 'https://cq.example';
+  fetchMock = vi.fn();
+  vi.stubGlobal('fetch', fetchMock);
+  resetStylesCache();
+});
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+  delete process.env.CONTENT_QUEEN_JOBS_ENABLED;
+  delete process.env.CONTENT_QUEEN_PRODUCE_ENABLED;
+  delete process.env.CONTENT_QUEEN_API_TOKEN;
+  delete process.env.CONTENT_QUEEN_API_URL;
+});
+
+const motionVideo = (over: Record<string, unknown> = {}) => ({
+  title: 'Your role as a buddy',
+  slo: 'Explain the buddy role at each stage',
+  models: [{ name: 'Empowerment Dynamic', author: 'David Emerald', summary: 'Coach, not Rescuer' }],
+  walkthroughs: [
+    { title: 'Rescuer vs Coach', situation: 'An employee says their manager never gives feedback.' },
+    { title: 'The 3 Es', situation: 'A new joiner is overwhelmed in week one.' },
+  ],
+  ...over,
+});
+
+describe('parseStyleInput', () => {
+  it('treats absent, null and empty as the default, exactly as their parseStyle does', () => {
+    for (const raw of [undefined, null, '']) {
+      expect(parseStyleInput(raw)).toEqual({ ok: true, style: 'character-arc' });
+    }
+  });
+
+  it('accepts both known ids and refuses anything else with a sentence', () => {
+    expect(parseStyleInput('motion-graphics')).toEqual({ ok: true, style: 'motion-graphics' });
+    const bad = parseStyleInput('claymation');
+    expect(bad.ok).toBe(false);
+    if (!bad.ok) expect(bad.detail).toContain('character-arc');
+    expect(parseStyleInput(42).ok).toBe(false);
+  });
+});
+
+describe('normaliseStyleList', () => {
+  const raw = {
+    default: 'character-arc',
+    styles: [
+      {
+        id: 'character-arc', label: 'Character Arc', default: true, summary: 's', bestFor: 'b',
+        // Theirs, minted from the request's own protocol — http behind a proxy.
+        previewUrl: 'http://internal-host/api/v1/styles/character-arc/preview.mp4',
+        previewSeconds: 12, estimatedCostPerLessonUsd: 1.5,
+        writingStyle: { narrator: 'A warm mentor', voice: 'Aoede', rules: ['r1', ''], sample: [{ line: 'l1' }, { nope: 1 }] },
+        secretField: 'must not reach a browser',
+      },
+      {
+        id: 'motion-graphics', label: 'Flat Motion Graphics', default: false, summary: 's2', bestFor: 'b2',
+        previewUrl: 'x', previewSeconds: 12, estimatedCostPerLessonUsd: 0.5,
+        writingStyle: { narrator: 'n', voice: 'v', rules: [], sample: [{ line: 'You are a buddy.', read: 'with a smile' }] },
+      },
+      { id: 'BAD ID', label: 'dropped' },
+    ],
+  };
+
+  it('rebuilds the preview URL on our base, so it is never mixed content', () => {
+    const list = normaliseStyleList(raw, 'https://cq.example')!;
+    expect(list.styles.map((s) => s.previewUrl)).toEqual([
+      'https://cq.example/api/v1/styles/character-arc/preview.mp4',
+      'https://cq.example/api/v1/styles/motion-graphics/preview.mp4',
+    ]);
+  });
+
+  it('carries only the fields it names, and drops empty rules and sample lines', () => {
+    const list = normaliseStyleList(raw, 'https://cq.example')!;
+    expect(list.styles).toHaveLength(2);
+    expect(JSON.stringify(list)).not.toContain('secretField');
+    expect(list.styles[0]!.writingStyle).toEqual({ narrator: 'A warm mentor', voice: 'Aoede', rules: ['r1'], sample: [{ line: 'l1' }] });
+    expect(list.styles[1]!.writingStyle!.sample).toEqual([{ line: 'You are a buddy.', read: 'with a smile' }]);
+  });
+
+  it('marks exactly one default, the one `default` names', () => {
+    const list = normaliseStyleList({ ...raw, default: 'motion-graphics' }, 'https://cq.example')!;
+    expect(list.defaultStyle).toBe('motion-graphics');
+    expect(list.styles.filter((s) => s.default).map((s) => s.id)).toEqual(['motion-graphics']);
+  });
+
+  it('is null for an answer with no usable style, so the caller can say so', () => {
+    expect(normaliseStyleList({ styles: [] })).toBeNull();
+    expect(normaliseStyleList('nope')).toBeNull();
+  });
+});
+
+describe('getStyles', () => {
+  it('reads their public list without a token, and caches it', async () => {
+    fetchMock.mockResolvedValue(jsonResponse({ default: 'character-arc', styles: [{ id: 'character-arc', label: 'C', previewUrl: 'p' }] }));
+    const a = await getStyles();
+    const b = await getStyles();
+    expect(a.ok && b.ok).toBe(true);
+    expect(fetchMock).toHaveBeenCalledTimes(1);
+    const [url, init] = fetchMock.mock.calls[0]!;
+    expect(url).toBe('https://cq.example/api/v1/styles');
+    expect(JSON.stringify((init as RequestInit).headers ?? {})).not.toContain('Bearer');
+  });
+
+  it('reports unavailable rather than throwing when they are down and nothing is cached', async () => {
+    fetchMock.mockRejectedValue(new Error('ECONNRESET'));
+    expect(await getStyles()).toEqual({ ok: false, reason: 'unavailable' });
+  });
+});
+
+describe('buildAuthoredPlan — motion-graphics', () => {
+  it('carries models, walk-throughs, numbered SLOs and the style', () => {
+    const r = buildAuthoredPlan({
+      topic: 'P&C Buddy', description: 'd', style: 'motion-graphics',
+      weeks: [{ title: 'Week 1', videos: [motionVideo(), motionVideo({ title: 'Listening first' })] }],
+    });
+    expect(r.ok).toBe(true);
+    if (!r.ok) return;
+    expect(r.plan.style).toBe('motion-graphics');
+    expect(r.plan.slos).toEqual([
+      { id: '1.1', text: 'Explain the buddy role at each stage' },
+      { id: '1.2', text: 'Explain the buddy role at each stage' },
+    ]);
+    const [first] = lessonsOf(r.plan);
+    expect(first!.sloIds).toEqual(['1.1']);
+    expect(first!.models).toEqual([{ name: 'Empowerment Dynamic', author: 'David Emerald', summary: 'Coach, not Rescuer' }]);
+    expect(first!.walkthroughs).toHaveLength(2);
+    // And it passes the same rule their build applies.
+    expect(motionPlanErrors(r.plan)).toEqual([]);
+  });
+
+  it('refuses a lesson with no named model, naming the lesson', () => {
+    const r = buildAuthoredPlan({ topic: 't', description: '', style: 'motion-graphics', videos: [motionVideo({ models: [{ name: '  ' }] })] });
+    expect(r.ok).toBe(false);
+    if (!r.ok) expect(r.detail).toMatch(/Video 1 needs a model/);
+  });
+
+  it('refuses fewer than two walk-throughs with a situation', () => {
+    const r = buildAuthoredPlan({
+      topic: 't', description: '', style: 'motion-graphics',
+      videos: [motionVideo({ walkthroughs: [{ title: 'only one', situation: 's' }, { title: 'no situation', situation: '' }] })],
+    });
+    expect(r.ok).toBe(false);
+    if (!r.ok) expect(r.detail).toMatch(/two walk-throughs/);
+  });
+
+  it('refuses a course tag hidden in a walk-through, like one in a title', () => {
+    const r = buildAuthoredPlan({
+      topic: 't', description: '', style: 'motion-graphics',
+      videos: [motionVideo({ walkthroughs: [{ situation: 'see [course-abc123]' }, { situation: 'fine' }] })],
+    });
+    expect(r.ok).toBe(false);
+  });
+
+  it('ignores motion fields entirely in character-arc', () => {
+    const r = buildAuthoredPlan({ topic: 't', description: '', videos: [motionVideo()] });
+    expect(r.ok).toBe(true);
+    if (!r.ok) return;
+    expect(r.plan.style).toBe('character-arc');
+    expect(r.plan.slos).toBeUndefined();
+    expect(lessonsOf(r.plan)[0]!.models).toBeUndefined();
+  });
+});
+
+describe('motionPlanErrors', () => {
+  it('reports their path for each missing field', () => {
+    const plan = {
+      title: 't',
+      modules: [{ title: 'm', lessons: [{ title: 'A', slo: 's', brief: 'b', difficulty: 'novice' }] }],
+    } as CoursePlan;
+    expect(motionPlanErrors(plan).map((p) => p.path)).toEqual([
+      'modules[0].lessons[0].models',
+      'modules[0].lessons[0].walkthroughs',
+    ]);
+  });
+
+  it('never throws on a malformed plan', () => {
+    expect(motionPlanErrors(null)).toEqual([]);
+    expect(motionPlanErrors({ modules: [null, { lessons: 'x' }] })).toEqual([]);
+  });
+});
+
+describe('style on the wire', () => {
+  const plan: CoursePlan = {
+    title: 't', style: 'motion-graphics',
+    modules: [{ title: 'm', lessons: [{ title: 'A', slo: 's', brief: 'b', difficulty: 'novice' }] }],
+  };
+
+  it('build sends the style it is given', async () => {
+    fetchMock.mockResolvedValue(jsonResponse({ courseId: 'course-x1', items: ['a'], rejected: [] }, 202));
+    await buildCourse({ plan, confirmLessons: 1, series: 'test', style: 'motion-graphics' });
+    const body = JSON.parse((fetchMock.mock.calls[0]![1] as RequestInit).body as string);
+    expect(body.style).toBe('motion-graphics');
+  });
+
+  it('their 400 invalid_plan is `invalid` (reversible) and names the lessons', async () => {
+    fetchMock.mockResolvedValue(jsonResponse({
+      error: 'invalid_plan',
+      message: 'This plan cannot be built: 1 problem(s).',
+      errors: [{ path: 'modules[0].lessons[0].walkthroughs', message: 'walks through at least two situations' }],
+    }, 400));
+    const res = await buildCourse({ plan, confirmLessons: 1, series: 'test', style: 'motion-graphics' });
+    expect(res.ok).toBe(false);
+    if (res.ok) return;
+    expect(res.reason).toBe('invalid');
+    expect(res.partnerCode).toBe('invalid_plan');
+    expect(res.detail).toContain('at least two situations');
+  });
+
+  it('make-video sends the style, defaulting to character-arc', async () => {
+    fetchMock.mockResolvedValue(jsonResponse({ jobId: 'j1', status: 'running', owner: 'tenant' }, 202));
+    await createJob('angry parent on the phone');
+    await createJob('angry parent on the phone', 'motion-graphics');
+    const bodies = fetchMock.mock.calls.map((c) => JSON.parse((c[1] as RequestInit).body as string));
+    expect(bodies.map((b) => b.style)).toEqual(['character-arc', 'motion-graphics']);
+  });
+
+  it('make-video maps their 400 invalid_style to `invalid`', async () => {
+    fetchMock.mockResolvedValue(jsonResponse({ error: 'invalid_style', message: 'Unknown style' }, 400));
+    const res = await createJob('t', 'motion-graphics');
+    expect(res).toEqual({ ok: false, reason: 'invalid' });
+  });
+});
