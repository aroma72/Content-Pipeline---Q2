+
+describe('normaliseStyleList', () => {
+  const raw = {
+    default: 'character-arc',
+    styles: [
+      {
+        id: 'character-arc', label: 'Character Arc', default: true, summary: 's', bestFor: 'b',
+        // Theirs, minted from the request's own protocol — http behind a proxy.
+        previewUrl: 'http://internal-host/api/v1/styles/character-arc/preview.mp4',
