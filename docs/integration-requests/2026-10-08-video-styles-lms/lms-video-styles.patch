+/**
+ * Guards on the video-style helpers. The rule that matters is the motion one: a Flat Motion
+ * Graphics video sent without a model and two walk-throughs is refused by Content Automation's
+ * build, so the form must not offer to send it — and must not drop what the instructor wrote.
+ */
+import { describe, it, expect } from 'vitest';
+import {
+  initialStyle,
+  styleLabel,
+  motionGaps,
+  motionPayload,
+  emptyMotionFields,
+  motionFieldsFromPlan,
+  costPerVideoText,
+  applyDraft,
+  applyDraftSlos,
+  canDraft,
+  draftRequestLessons,
+  editedVideoCount,
+  shouldAutoDraft,
+  type DraftableVideo,
+  type StylesResponse,
+} from './video-styles';
+
+const list: StylesResponse = {
+  default: 'character-arc',
+  styles: [
+    { id: 'character-arc', label: 'Character Arc', default: true, summary: '', bestFor: '', previewUrl: null, previewSeconds: 12, estimatedCostPerLessonUsd: 1.5, writingStyle: null },
+    { id: 'motion-graphics', label: 'Flat Motion Graphics', default: false, summary: '', bestFor: '', previewUrl: null, previewSeconds: 12, estimatedCostPerLessonUsd: 0.5, writingStyle: null },
+  ],
+};
+
+describe('initialStyle', () => {
+  it('starts on the style the list marks default', () => {
+    expect(initialStyle(list)).toBe('character-arc');
+    expect(initialStyle({ ...list, default: 'motion-graphics' })).toBe('motion-graphics');
+  });
+
+  it('falls back to character-arc when the list could not be loaded', () => {
+    expect(initialStyle(null)).toBe('character-arc');
+    expect(initialStyle({ default: 'x', styles: [] })).toBe('character-arc');
+  });
+});
+
+describe('styleLabel', () => {
+  it('labels a stored id without the list, and an old row as Character Arc', () => {
+    expect(styleLabel('motion-graphics')).toBe('Flat Motion Graphics');
+    expect(styleLabel(null)).toBe('Character Arc');
+    expect(styleLabel('new-style', list.styles)).toBe('new-style');
+    expect(styleLabel('motion-graphics', list.styles)).toBe('Flat Motion Graphics');
+  });
+});
+
+describe('motionGaps', () => {
+  it('a fresh video needs a model and two walk-throughs', () => {
+    expect(motionGaps(emptyMotionFields())).toEqual(['a model', 'two walk-throughs']);
+  });
+
+  it('counts only walk-throughs that have a situation', () => {
+    expect(motionGaps({
+      models: [{ name: 'SCARF', author: '', summary: '' }],
+      walkthroughs: [{ title: 'a title only', situation: '' }, { title: '', situation: 'A real situation' }],
+    })).toEqual(['a second walk-through']);
+  });
+
+  it('is empty once the minimum is met', () => {
+    expect(motionGaps({
+      models: [{ name: 'SCARF', author: 'David Rock', summary: '' }],
+      walkthroughs: [{ title: '', situation: 'one' }, { title: '', situation: 'two' }],
+    })).toEqual([]);
+  });
+});
+
+describe('motionPayload', () => {
+  it('drops blank rows and blank optional fields', () => {
+    expect(motionPayload({
+      models: [{ name: ' SCARF ', author: 'David Rock', summary: '' }, { name: '', author: 'x', summary: '' }],
+      walkthroughs: [{ title: '', situation: 'one' }, { title: 'T', situation: 'two' }, { title: 'empty', situation: ' ' }],
+    })).toEqual({
+      models: [{ name: 'SCARF', author: 'David Rock' }],
+      walkthroughs: [{ situation: 'one' }, { title: 'T', situation: 'two' }],
+    });
+  });
+});
+
+describe('motionFieldsFromPlan', () => {
+  it('round-trips what was sent, so a resumed plan shows what will be built', () => {
+    const sent = { models: [{ name: 'GROW', author: 'John Whitmore' }], walkthroughs: [{ situation: 'a' }, { title: 'b', situation: 'b' }] };
+    expect(motionPayload(motionFieldsFromPlan(sent))).toEqual(sent);
+  });
+
+  it('pads a plan with too few rows up to the minimum, never below it', () => {
+    const f = motionFieldsFromPlan({ walkthroughs: [{ situation: 'only' }] });
+    expect(f.models).toHaveLength(1);
+    expect(f.walkthroughs).toHaveLength(2);
+    expect(f.walkthroughs[0]!.situation).toBe('only');
+  });
+});
+
+describe('costPerVideoText', () => {
+  it('says it is an estimate, and says nothing without a number', () => {
+    expect(costPerVideoText(0.5)).toBe('about $0.50 per video');
+    expect(costPerVideoText(null)).toBeNull();
+  });
+});
+
+describe('drafting — never overwrite what the instructor edited', () => {
+  const draft = {
+    slos: [{ id: '1.1', text: 'Explain the role' }, { id: '1.2', text: 'Reflect back' }],
+    lessons: [
+      { index: 0, title: 'A', sloIds: ['1.1'], models: [{ name: 'GROW', author: 'John Whitmore' }], walkthroughs: [{ situation: 'a1' }, { situation: 'a2' }] },
+      { index: 1, title: 'B', sloIds: ['1.2'], models: [{ name: 'RASA' }], walkthroughs: [{ situation: 'b1' }, { situation: 'b2' }] },
+    ],
+  };
+  const sent = [{ title: 'A', slo: 'sa' }, { title: 'B', slo: 'sb' }];
+  const edited = {
+    models: [{ name: 'MINE', author: 'Me', summary: '' }],
+    walkthroughs: [{ title: '', situation: 'mine 1' }, { title: '', situation: 'mine 2' }],
+  };
+
+  it('fills untouched videos and marks them drafted, not edited', () => {
+    const r = applyDraft<DraftableVideo>([{ title: 'A', slo: 'sa' }, { title: 'B', slo: 'sb' }], draft, sent, { replaceEdited: false });
+    expect(r.videos[0]!.motion!.models[0]!.name).toBe('GROW');
+    expect(r.videos[1]!.sloIds).toEqual(['1.2']);
+    expect(r.videos.every((v) => v.drafted && !v.motionEdited)).toBe(true);
+    expect(motionGaps(r.videos[0]!.motion)).toEqual([]);
+  });
+
+  it('keeps an edited video unless the instructor chose to replace it', () => {
+    const videos = [{ title: 'A', slo: 'sa', motion: edited, motionEdited: true, drafted: true }, { title: 'B', slo: 'sb' }];
+    const kept = applyDraft<DraftableVideo>(videos, draft, sent, { replaceEdited: false });
+    expect(kept.keptEdited).toBe(1);
+    expect(kept.videos[0]).toBe(videos[0]);
+    expect(kept.videos[1]!.motion!.models[0]!.name).toBe('RASA');
+
+    const replaced = applyDraft<DraftableVideo>(videos, draft, sent, { replaceEdited: true });
+    expect(replaced.keptEdited).toBe(0);
+    expect(replaced.videos[0]!.motion!.models[0]!.name).toBe('GROW');
+    expect(replaced.videos[0]!.motionEdited).toBe(false);
+  });
+
+  it('skips a video whose title or SLO changed while the draft was out, even when replacing', () => {
+    const videos = [{ title: 'A, renamed', slo: 'sa' }, { title: 'B', slo: 'sb' }];
+    const r = applyDraft<DraftableVideo>(videos, draft, sent, { replaceEdited: true });
+    expect(r.skippedChanged).toBe(1);
+    expect(r.videos[0]).toBe(videos[0]);
+    expect(r.videos[1]!.drafted).toBe(true);
+  });
+
+  it('keeps hand-edited course SLOs unless replacing', () => {
+    const mine = { slos: [{ id: '1.1', text: 'my words' }], edited: true };
+    expect(applyDraftSlos(mine, draft, { replaceEdited: false })).toBe(mine);
+    expect(applyDraftSlos(mine, draft, { replaceEdited: true })).toEqual({ slos: draft.slos, edited: false });
+    expect(applyDraftSlos({ slos: [], edited: false }, draft, { replaceEdited: false }).slos).toHaveLength(2);
+  });
+
+  it('counts edited videos for the in-page confirm', () => {
+    expect(editedVideoCount([{ title: 'a', slo: 'b', motionEdited: true }, { title: 'c', slo: 'd' }])).toBe(1);
+  });
+});
+
+describe('when to draft automatically', () => {
+  const written = [{ title: 'A', slo: 'sa' }, { title: 'B', slo: 'sb' }];
+
+  it('once every video has a title and an SLO, in motion graphics, and nothing is drafted or edited', () => {
+    expect(shouldAutoDraft({ motion: true, videos: written, autoDraftTried: false, drafting: false })).toBe(true);
+  });
+
+  it('not in character-arc, not twice, not while drafting, not with a blank SLO', () => {
+    expect(shouldAutoDraft({ motion: false, videos: written, autoDraftTried: false, drafting: false })).toBe(false);
+    expect(shouldAutoDraft({ motion: true, videos: written, autoDraftTried: true, drafting: false })).toBe(false);
+    expect(shouldAutoDraft({ motion: true, videos: written, autoDraftTried: false, drafting: true })).toBe(false);
+    expect(shouldAutoDraft({ motion: true, videos: [...written, { title: 'C', slo: ' ' }], autoDraftTried: false, drafting: false })).toBe(false);
+  });
+
+  it('not once the instructor has written a model or walk-through by hand', () => {
+    expect(shouldAutoDraft({ motion: true, videos: [{ ...written[0]!, motionEdited: true }], autoDraftTried: false, drafting: false })).toBe(false);
+  });
+
+  it('sends titles and SLOs trimmed, in order, and refuses more than 30', () => {
+    expect(draftRequestLessons([{ title: ' A ', slo: ' sa ' }])).toEqual([{ title: 'A', slo: 'sa' }]);
+    expect(canDraft(Array.from({ length: 31 }, () => ({ title: 't', slo: 's' })))).toBe(false);
+  });
+});
