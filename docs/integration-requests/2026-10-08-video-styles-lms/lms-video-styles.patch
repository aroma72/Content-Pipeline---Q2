+'use client';
+/**
+ * Video styles (Content Automation, 2026-10-08) — the picker and the pieces that show a style's
+ * consequences. Pure helpers and the rules live in lib/video-styles.ts.
+ *
+ * THE PICKER SITS WHERE THE TOPIC IS TYPED, not on a page of its own. The style decides what the
+ * rest of the form asks for (a Flat Motion Graphics video is built from a model and walk-throughs),
+ * so choosing it after the topic and before the videos is the only order in which every field the
+ * instructor sees is one that will be used.
+ *
+ * EACH CARD SHOWS WHAT YOU WILL GET, NOT A DESCRIPTION OF IT: their 12-second preview, muted and
+ * looping, and "how the script sounds" — who narrates and in what voice always visible, the rules
+ * and real sample lines one click away. The sample lines are from shipped videos.
+ */
+import { Loader2, Plus, X } from 'lucide-react';
+import {
+  costPerVideoText,
+  styleLabel,
+  type MotionFields,
+  type VideoStyleInfo,
+} from '@/lib/video-styles';
+
+const MAX_MODELS = 3;
+const MAX_WALKTHROUGHS = 5;
+
+const INPUT =
+  'w-full rounded-lg border border-[#ebebf0] px-3 py-2 text-[13px] text-[#0f1222] '
+  + 'placeholder:text-[#9ca3af] focus:outline-none focus:border-[#3c65f5] focus:ring-2 '
+  + 'focus:ring-[#3c65f5]/10 disabled:bg-gray-50 disabled:text-gray-500 transition-colors';
+
+/** "How the script sounds". Narrator and voice always shown; rules and sample lines in a disclosure. */
+function WritingStyleBlock({ style, compact }: { style: VideoStyleInfo; compact: boolean }) {
+  const w = style.writingStyle;
+  if (!w) return null;
+  return (
+    <div className={`border-t border-[#ebebf0] ${compact ? 'px-3 py-2' : 'px-4 py-3'}`}>
+      <p className="text-[11px] font-semibold uppercase tracking-wide text-[#9ca3af]">How the script sounds</p>
+      {w.narrator ? <p className="mt-1 text-[12px] text-[#4b5563]"><span className="font-medium text-[#0f1222]">Narrator:</span> {w.narrator}</p> : null}
+      {w.voice ? <p className="mt-0.5 text-[12px] text-[#4b5563]"><span className="font-medium text-[#0f1222]">Voice:</span> {w.voice}</p> : null}
+      {w.rules.length > 0 || w.sample.length > 0 ? (
+        <details className="mt-1.5 group">
+          <summary className="cursor-pointer select-none text-[12px] font-medium text-[#3c65f5] hover:underline">
+            Rules and sample lines
+          </summary>
+          {w.rules.length > 0 ? (
+            <ul className="mt-2 list-disc space-y-0.5 pl-4 text-[12px] text-[#4b5563]">
+              {w.rules.map((r, i) => <li key={i}>{r}</li>)}
+            </ul>
+          ) : null}
+          {w.sample.length > 0 ? (
+            <blockquote className="mt-2 space-y-1.5 border-l-2 border-[#3c65f5]/30 pl-3">
+              {w.sample.map((s, i) => (
+                <p key={i} className="text-[12px] text-[#0f1222]">
+                  &ldquo;{s.line}&rdquo;
+                  {s.read ? <span className="ml-1.5 text-[11px] italic text-[#9ca3af]">({s.read})</span> : null}
+                </p>
+              ))}
+            </blockquote>
+          ) : null}
+        </details>
+      ) : null}
+    </div>
+  );
+}
+
+/**
+ * The style picker. `styles === null` while loading; `error` when the list could not be had, in
+ * which case the form carries on in the default style and says so rather than blocking.
+ */
+export function VideoStylePicker({
+  styles,
+  value,
+  onChange,
+  disabled = false,
+  compact = false,
+  error = null,
+}: {
+  styles: VideoStyleInfo[] | null;
+  value: string;
+  onChange: (id: string) => void;
+  disabled?: boolean;
+  compact?: boolean;
+  error?: string | null;
+}) {
+  if (error) {
+    return (
+      <p className="mt-2 rounded-lg border border-[#f59e0b]/30 bg-[#fffbeb] p-2 text-[12px] text-[#92400e]">
+        {error} This will be made in {styleLabel(value)}.
+      </p>
+    );
+  }
+  if (styles === null) {
+    return (
+      <p className="mt-2 inline-flex items-center gap-1.5 text-[12px] text-[#9ca3af]">
+        <Loader2 size={12} className="animate-spin" /> Loading the video styles…
+      </p>
+    );
+  }
+
+  return (
+    <div
+      role="radiogroup"
+      aria-label="Video style"
+      className={`mt-2 grid gap-3 ${compact ? 'grid-cols-1 sm:grid-cols-2' : 'grid-cols-1 md:grid-cols-2'}`}
+    >
+      {styles.map((s) => {
+        const on = s.id === value;
+        const cost = costPerVideoText(s.estimatedCostPerLessonUsd);
+        return (
+          <div
+            key={s.id}
+            data-testid={`style-card-${s.id}`}
+            className={`overflow-hidden rounded-xl border bg-white transition-colors ${
+              on ? 'border-[#3c65f5] ring-2 ring-[#3c65f5]/15' : 'border-[#ebebf0]'
+            } ${disabled && !on ? 'opacity-50' : ''}`}
+          >
+            <button
+              type="button"
+              role="radio"
+              aria-checked={on}
+              disabled={disabled}
+              onClick={() => onChange(s.id)}
+              className="block w-full text-left disabled:cursor-default"
+            >
+              {s.previewUrl ? (
+                <video
+                  src={s.previewUrl}
+                  muted
+                  loop
+                  playsInline
+                  autoPlay
+                  preload="metadata"
+                  aria-label={`${s.label} — ${s.previewSeconds ?? 12}-second preview`}
+                  className={`w-full bg-[#0f1222] object-cover ${compact ? 'aspect-video max-h-32' : 'aspect-video'}`}
+                />
+              ) : null}
+              <div className={compact ? 'px-3 py-2' : 'px-4 py-3'}>
+                <div className="flex items-center justify-between gap-2">
+                  <p className="text-[14px] font-semibold text-[#0f1222]">{s.label}</p>
+                  <span
+                    aria-hidden
+                    className={`h-4 w-4 shrink-0 rounded-full border-2 ${on ? 'border-[#3c65f5] bg-[#3c65f5] shadow-[inset_0_0_0_2px_white]' : 'border-[#d1d5db]'}`}
+                  />
+                </div>
+                {s.summary ? <p className="mt-1 text-[12px] text-[#4b5563]">{s.summary}</p> : null}
+                {s.bestFor ? (
+                  <p className="mt-1 text-[12px] text-[#6b7280]"><span className="font-medium">Best for:</span> {s.bestFor}</p>
+                ) : null}
+                {cost ? <p className="mt-1 text-[11px] text-[#9ca3af]">Content Automation estimates {cost}.</p> : null}
+              </div>
+            </button>
+            <WritingStyleBlock style={s} compact={compact} />
+          </div>
+        );
+      })}
+    </div>
+  );
+}
+
+/** The style as a small pill — the Library, the course page, the video page. */
+export function StyleBadge({ style }: { style: string | null | undefined }) {
+  return (
+    <span
+      data-testid="style-badge"
+      className="inline-flex items-center rounded-full bg-[#f0f4ff] px-2 py-0.5 text-[11px] font-medium text-[#3c65f5]"
+    >
+      {styleLabel(style)}
+    </span>
+  );
+}
+
+/**
+ * The model and walk-throughs ONE motion-graphics video is built from, as editable rows. Starts at
+ * their minimum (one model, two walk-throughs); rows beyond the minimum can be removed.
+ */
+export function MotionFieldsEditor({
+  value,
+  onChange,
+  disabled = false,
+  label,
+}: {
+  value: MotionFields;
+  onChange: (next: MotionFields) => void;
+  disabled?: boolean;
+  /** e.g. "Week 1 video 2" — prefixes every aria-label so each input is findable. */
+  label: string;
+}) {
+  const setModel = (i: number, field: keyof MotionFields['models'][number], v: string) =>
+    onChange({ ...value, models: value.models.map((m, j) => (j === i ? { ...m, [field]: v } : m)) });
+  const setWalk = (i: number, field: keyof MotionFields['walkthroughs'][number], v: string) =>
+    onChange({ ...value, walkthroughs: value.walkthroughs.map((w, j) => (j === i ? { ...w, [field]: v } : w)) });
+
+  return (
+    <div className="mt-3 space-y-3 rounded-md border border-dashed border-[#c7d2fe] bg-white p-3">
+      <div>
+        <p className="text-[12px] font-medium text-[#0f1222]">Model it teaches through</p>
+        <p className="text-[11px] text-[#6b7280]">A named framework and who it is by — e.g. SCARF, David Rock.</p>
+        {value.models.map((m, i) => (
+          <div key={i} className="mt-2 grid grid-cols-1 gap-2 sm:grid-cols-[1fr_1fr_auto]">
+            <input
+              value={m.name} onChange={(e) => setModel(i, 'name', e.target.value)} disabled={disabled}
+              placeholder="Model name" maxLength={120} className={INPUT} aria-label={`${label} model ${i + 1} name`}
+            />
+            <input
+              value={m.author} onChange={(e) => setModel(i, 'author', e.target.value)} disabled={disabled}
+              placeholder="Author" maxLength={120} className={INPUT} aria-label={`${label} model ${i + 1} author`}
+            />
+            {!disabled && value.models.length > 1 ? (
+              <button
+                type="button" title="Remove this model"
+                onClick={() => onChange({ ...value, models: value.models.filter((_, j) => j !== i) })}
+                className="rounded px-1.5 text-[#dc2626] hover:bg-[#fef2f2]"
+              >
+                <X size={14} />
+              </button>
+            ) : <span />}
+            <input
+              value={m.summary} onChange={(e) => setModel(i, 'summary', e.target.value)} disabled={disabled}
+              placeholder="In one line, what the model says (optional)" maxLength={400}
+              className={`${INPUT} sm:col-span-2`} aria-label={`${label} model ${i + 1} summary`}
+            />
+          </div>
+        ))}
+        {!disabled && value.models.length < MAX_MODELS ? (
+          <button
+            type="button"
+            onClick={() => onChange({ ...value, models: [...value.models, { name: '', author: '', summary: '' }] })}
+            className="mt-2 inline-flex items-center gap-1 text-[12px] font-medium text-[#3c65f5] hover:underline"
+          >
+            <Plus size={12} /> Another model
+          </button>
+        ) : null}
+      </div>
+
+      <div>
+        <p className="text-[12px] font-medium text-[#0f1222]">Walk-throughs (at least two)</p>
+        <p className="text-[11px] text-[#6b7280]">
+          Real situations the video walks the learner through, step by step, using the model.
+        </p>
+        {value.walkthroughs.map((w, i) => (
+          <div key={i} className="mt-2 rounded-md bg-[#f8f9fb] p-2">
+            <div className="flex items-center gap-2">
+              <input
+                value={w.title} onChange={(e) => setWalk(i, 'title', e.target.value)} disabled={disabled}
+                placeholder={`Walk-through ${i + 1} title (optional)`} maxLength={120} className={INPUT}
+                aria-label={`${label} walk-through ${i + 1} title`}
+              />
+              {!disabled && value.walkthroughs.length > 2 ? (
+                <button
+                  type="button" title="Remove this walk-through"
+                  onClick={() => onChange({ ...value, walkthroughs: value.walkthroughs.filter((_, j) => j !== i) })}
+                  className="rounded px-1.5 text-[#dc2626] hover:bg-[#fef2f2]"
+                >
+                  <X size={14} />
+                </button>
+              ) : null}
+            </div>
+            <textarea
+              value={w.situation} onChange={(e) => setWalk(i, 'situation', e.target.value)} disabled={disabled}
+              rows={2} maxLength={1000}
+              placeholder="The situation — e.g. An employee says their manager never gives feedback…"
+              className={`mt-1.5 ${INPUT}`} aria-label={`${label} walk-through ${i + 1} situation`}
+            />
+          </div>
+        ))}
+        {!disabled && value.walkthroughs.length < MAX_WALKTHROUGHS ? (
+          <button
+            type="button"
+            onClick={() => onChange({ ...value, walkthroughs: [...value.walkthroughs, { title: '', situation: '' }] })}
+            className="mt-2 inline-flex items-center gap-1 text-[12px] font-medium text-[#3c65f5] hover:underline"
+          >
+            <Plus size={12} /> Another walk-through
+          </button>
+        ) : null}
+      </div>
+    </div>
+  );
+}
+
+/** A course's numbered SLOs, as the plan carries them in motion-graphics. */
+export function CourseSlos({ slos }: { slos: { id: string; text: string }[] | null | undefined }) {
+  if (!slos || slos.length === 0) return null;
+  return (
+    <div className="mt-4 rounded-lg border border-[#ebebf0] bg-white p-4">
+      <p className="text-[13px] font-semibold text-[#0f1222]">Course outcomes (SLOs)</p>
+      <ol className="mt-2 space-y-1">
+        {slos.map((s) => (
+          <li key={s.id} className="flex gap-2 text-[12px] text-[#4b5563]">
+            <span className="shrink-0 rounded bg-[#f0f4ff] px-1.5 font-mono text-[11px] text-[#3c65f5]">{s.id}</span>
+            <span>{s.text}</span>
+          </li>
+        ))}
+      </ol>
+    </div>
+  );
+}
+
+/** One motion lesson's SLO ids, models (with authors) and walk-throughs, read-only. */
+export function MotionLessonDetails({
+  lesson,
+}: {
+  lesson: {
+    sloIds?: string[];
+    models?: { name: string; author?: string; summary?: string }[];
+    walkthroughs?: { title?: string; situation: string }[];
+  } | null | undefined;
+}) {
+  if (!lesson) return null;
+  const { sloIds = [], models = [], walkthroughs = [] } = lesson;
+  if (sloIds.length === 0 && models.length === 0 && walkthroughs.length === 0) return null;
+  return (
+    <div className="mt-2 space-y-1.5">
+      {sloIds.length > 0 ? (
+        <div className="flex flex-wrap gap-1">
+          {sloIds.map((id) => (
+            <span key={id} className="rounded bg-[#f0f4ff] px-1.5 font-mono text-[11px] text-[#3c65f5]">SLO {id}</span>
+          ))}
+        </div>
+      ) : null}
+      {models.length > 0 ? (
+        <p className="text-[12px] text-[#4b5563]">
+          <span className="font-medium text-[#0f1222]">Model{models.length > 1 ? 's' : ''}:</span>{' '}
+          {models.map((m, i) => (
+            <span key={i}>
+              {i > 0 ? '; ' : ''}{m.name}{m.author ? <span className="text-[#6b7280]"> — {m.author}</span> : null}
+            </span>
+          ))}
+        </p>
+      ) : null}
+      {walkthroughs.length > 0 ? (
+        <div className="text-[12px] text-[#4b5563]">
+          <span className="font-medium text-[#0f1222]">Walk-throughs:</span>
+          <ul className="mt-0.5 list-disc space-y-0.5 pl-4">
+            {walkthroughs.map((w, i) => (
+              <li key={i}>{w.title ? <span className="font-medium">{w.title}: </span> : null}{w.situation}</li>
+            ))}
+          </ul>
+        </div>
+      ) : null}
+    </div>
+  );
+}
