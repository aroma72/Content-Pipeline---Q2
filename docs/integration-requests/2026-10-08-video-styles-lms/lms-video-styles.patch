@@ -0,0 +1,98 @@
+/**
+ * Guards on the video-style helpers. The rule that matters is the motion one: a Flat Motion
+ * Graphics video sent without a model and two walk-throughs is refused by Content Automation's
+ * build, so the form must not offer to send it — and must not drop what the instructor wrote.
+ */
+import { describe, it, expect } from 'vitest';
+import {
+  initialStyle,
+  styleLabel,
+  motionGaps,
+  motionPayload,
+  emptyMotionFields,
+  motionFieldsFromPlan,
+  costPerVideoText,
+  type StylesResponse,
+} from './video-styles';
+
+const list: StylesResponse = {
+  default: 'character-arc',
+  styles: [
+    { id: 'character-arc', label: 'Character Arc', default: true, summary: '', bestFor: '', previewUrl: null, previewSeconds: 12, estimatedCostPerLessonUsd: 1.5, writingStyle: null },
+    { id: 'motion-graphics', label: 'Flat Motion Graphics', default: false, summary: '', bestFor: '', previewUrl: null, previewSeconds: 12, estimatedCostPerLessonUsd: 0.5, writingStyle: null },
+  ],
+};
+
+describe('initialStyle', () => {
+  it('starts on the style the list marks default', () => {
+    expect(initialStyle(list)).toBe('character-arc');
+    expect(initialStyle({ ...list, default: 'motion-graphics' })).toBe('motion-graphics');
+  });
+
+  it('falls back to character-arc when the list could not be loaded', () => {
+    expect(initialStyle(null)).toBe('character-arc');
+    expect(initialStyle({ default: 'x', styles: [] })).toBe('character-arc');
+  });
+});
+
+describe('styleLabel', () => {
+  it('labels a stored id without the list, and an old row as Character Arc', () => {
+    expect(styleLabel('motion-graphics')).toBe('Flat Motion Graphics');
+    expect(styleLabel(null)).toBe('Character Arc');
+    expect(styleLabel('new-style', list.styles)).toBe('new-style');
+    expect(styleLabel('motion-graphics', list.styles)).toBe('Flat Motion Graphics');
+  });
+});
+
+describe('motionGaps', () => {
+  it('a fresh video needs a model and two walk-throughs', () => {
+    expect(motionGaps(emptyMotionFields())).toEqual(['a model', 'two walk-throughs']);
+  });
+
+  it('counts only walk-throughs that have a situation', () => {
+    expect(motionGaps({
+      models: [{ name: 'SCARF', author: '', summary: '' }],
+      walkthroughs: [{ title: 'a title only', situation: '' }, { title: '', situation: 'A real situation' }],
+    })).toEqual(['a second walk-through']);
+  });
+
+  it('is empty once the minimum is met', () => {
+    expect(motionGaps({
+      models: [{ name: 'SCARF', author: 'David Rock', summary: '' }],
+      walkthroughs: [{ title: '', situation: 'one' }, { title: '', situation: 'two' }],
+    })).toEqual([]);
+  });
+});
+
+describe('motionPayload', () => {
+  it('drops blank rows and blank optional fields', () => {
+    expect(motionPayload({
+      models: [{ name: ' SCARF ', author: 'David Rock', summary: '' }, { name: '', author: 'x', summary: '' }],
+      walkthroughs: [{ title: '', situation: 'one' }, { title: 'T', situation: 'two' }, { title: 'empty', situation: ' ' }],
+    })).toEqual({
+      models: [{ name: 'SCARF', author: 'David Rock' }],
+      walkthroughs: [{ situation: 'one' }, { title: 'T', situation: 'two' }],
+    });
+  });
+});
+
+describe('motionFieldsFromPlan', () => {
+  it('round-trips what was sent, so a resumed plan shows what will be built', () => {
+    const sent = { models: [{ name: 'GROW', author: 'John Whitmore' }], walkthroughs: [{ situation: 'a' }, { title: 'b', situation: 'b' }] };
+    expect(motionPayload(motionFieldsFromPlan(sent))).toEqual(sent);
+  });
+
+  it('pads a plan with too few rows up to the minimum, never below it', () => {
+    const f = motionFieldsFromPlan({ walkthroughs: [{ situation: 'only' }] });
+    expect(f.models).toHaveLength(1);
+    expect(f.walkthroughs).toHaveLength(2);
+    expect(f.walkthroughs[0]!.situation).toBe('only');
+  });
+});
+
+describe('costPerVideoText', () => {
+  it('says it is an estimate, and says nothing without a number', () => {
+    expect(costPerVideoText(0.5)).toBe('about $0.50 per video');
+    expect(costPerVideoText(null)).toBeNull();
+  });
+});
