--- /dev/null
+++ b/apps/api/src/lib/content-queen-styles.ts
@@ -0,0 +1,295 @@
+/**
+ * Content Automation's video styles (contract 1.2, additive, 2026-10-08).
+ *
+ *   GET {CONTENT_QUEEN_API_URL}/api/v1/styles                       -> the styles, public, no token
+ *   GET {CONTENT_QUEEN_API_URL}/api/v1/styles/:id/preview.mp4       -> a 12-second sample, public, Range
+ *
+ * A course or a single video is made in ONE style throughout, chosen by the instructor where they
+ * type the topic. The id travels as `style` on `/courses/plan`, `/courses/build` and
+ * `/demo/make-video`; an id they do not list is `400 invalid_style` on each, before anything is
+ * reserved or queued. Their request: docs/integration-requests/2026-10-08-video-styles.md.
+ *
+ * WHY THE IDS ARE ALSO WRITTEN DOWN HERE. The list is fetched, never hard-coded into a page — the
+ * labels, prices and sample lines are theirs to change. But the IDS are validated on OUR side
+ * before a row is written, the same way `series` is: an unknown style that reaches their build
+ * after our ledger row exists is a reversal we did not need to make. Two ids today; a third one
+ * they add shows up in the picker (it is fetched) and is refused by `parseStyleInput` until it is
+ * added to `VIDEO_STYLES` — deliberately, because a new style can carry new plan requirements, as
+ * `motion-graphics` did.
+ *
+ * WHAT EACH STYLE MEANS FOR US.
+ *   character-arc   — the original illustrated story about Ali. Unchanged. The default.
+ *   motion-graphics — flat motion graphics spoken to "you". Every lesson is BUILT from at least one
+ *                     named model and at least two walk-throughs; their build refuses a lesson
+ *                     without them (`400 invalid_plan`). `motionPlanErrors` checks the same rule
+ *                     here, before anything is charged.
+ */
+
+const DEFAULT_BASE = 'https://content-queen-production.up.railway.app';
+
+function baseUrl(): string {
+  return (process.env.CONTENT_QUEEN_API_URL || DEFAULT_BASE).replace(/\/+$/, '');
+}
+
+/** The ids we accept and forward. See the header for why this is a list and not a fetch. */
+export const VIDEO_STYLES = ['character-arc', 'motion-graphics'] as const;
+export type VideoStyle = (typeof VIDEO_STYLES)[number];
+
+/** What a request without a `style` is made in — theirs too. Rows made before styles report this. */
+export const DEFAULT_VIDEO_STYLE: VideoStyle = 'character-arc';
+
+export function isVideoStyle(v: unknown): v is VideoStyle {
+  return typeof v === 'string' && (VIDEO_STYLES as readonly string[]).includes(v);
+}
+
+/**
+ * A `style` from a request body. Absent, null or empty is the default, exactly as their own
+ * `parseStyle` treats it; anything else must be one of ours.
+ */
+export function parseStyleInput(
+  raw: unknown,
+): { ok: true; style: VideoStyle } | { ok: false; detail: string } {
+  if (raw === undefined || raw === null || raw === '') return { ok: true, style: DEFAULT_VIDEO_STYLE };
+  if (isVideoStyle(raw)) return { ok: true, style: raw };
+  return {
+    ok: false,
+    detail: `Unknown video style ${JSON.stringify(String(raw).slice(0, 60))}. Choose one of: ${VIDEO_STYLES.join(', ')}.`,
+  };
+}
+
+// ─── The list, as a browser may see it ─────────────────────────────────────────────────────────
+
+export interface WritingStyleSample {
+  line: string;
+  /** motion-graphics only: how the line is read ("with a warm, welcoming smile"). */
+  read?: string;
+}
+
+export interface WritingStyle {
+  narrator: string;
+  voice: string;
+  rules: string[];
+  sample: WritingStyleSample[];
+}
+
+export interface VideoStyleInfo {
+  id: string;
+  label: string;
+  default: boolean;
+  summary: string;
+  bestFor: string;
+  /** Absolute and public. Rebuilt from OUR configured base — see normaliseStyle. Null when they gave none. */
+  previewUrl: string | null;
+  previewSeconds: number | null;
+  /** THEIR estimate. Shown beside the style; never the figure our ledger charges. */
+  estimatedCostPerLessonUsd: number | null;
+  writingStyle: WritingStyle | null;
+}
+
+export interface VideoStyleList {
+  defaultStyle: string;
+  styles: VideoStyleInfo[];
+}
+
+export type StylesResult = { ok: true; data: VideoStyleList } | { ok: false; reason: 'unavailable' };
+
+// ─── Unknown-field reporting ────────────────────────────────────────────────────────────────────
+// The same discipline as the course, job and catalogue clients (tests/unit/partner-clients-detect-
+// drift.test.ts): a field they add to this payload is dropped by the normaliser below, so it must
+// at least be HEARD. Deduplicated by shape — every Build tab load asks for this list.
+
+const seenUnknownStyleFields = new Set<string>();
+
+/** Test seam: the dedupe is module state. Also clears the cache, so the next call really parses. */
+export function resetStyleUnknownFieldLog(): void {
+  seenUnknownStyleFields.clear();
+  cached = null;
+}
+
+const KNOWN_STYLE_LIST_FIELDS = ['default', 'styles', 'howToUse'] as const;
+const KNOWN_STYLE_FIELDS = [
+  'id', 'label', 'default', 'summary', 'bestFor', 'previewUrl', 'previewSeconds',
+  'estimatedCostPerLessonUsd', 'writingStyle',
+] as const;
+const KNOWN_WRITING_STYLE_FIELDS = ['narrator', 'voice', 'rules', 'sample'] as const;
+const KNOWN_SAMPLE_FIELDS = ['line', 'read'] as const;
+
+function reportUnknownStyleFields(context: string, raw: unknown, known: readonly string[]): void {
+  if (!raw || typeof raw !== 'object' || Array.isArray(raw)) return;
+  const unknown = Object.keys(raw).filter((k) => !known.includes(k));
+  if (unknown.length === 0) return;
+  const signature = `${context}:${unknown.sort().join(',')}`;
+  if (seenUnknownStyleFields.has(signature)) return;
+  seenUnknownStyleFields.add(signature);
+  console.warn(
+    `[content-queen-styles] upstream sent field(s) we do not read on ${context}: ${unknown.join(', ')}. `
+    + 'If one of these matters, add it to VideoStyleInfo and normaliseStyle — nothing else will notice it.',
+  );
+}
+
+function text(v: unknown, max: number): string | undefined {
+  return typeof v === 'string' && v.trim().length > 0 ? v.trim().slice(0, max) : undefined;
+}
+
+function finite(v: unknown): number | null {
+  return typeof v === 'number' && Number.isFinite(v) ? v : null;
+}
+
+function normaliseWritingStyle(raw: unknown): WritingStyle | null {
+  if (!raw || typeof raw !== 'object') return null;
+  const w = raw as Record<string, unknown>;
+  reportUnknownStyleFields('a writing style', w, KNOWN_WRITING_STYLE_FIELDS);
+  const narrator = text(w.narrator, 500);
+  const voice = text(w.voice, 500);
+  if (!narrator && !voice) return null;
+  const rules = Array.isArray(w.rules)
+    ? w.rules.map((r) => text(r, 500)).filter((r): r is string => !!r).slice(0, 12)
+    : [];
+  const sample = Array.isArray(w.sample)
+    ? w.sample
+        .map((s) => {
+          const o = (s ?? {}) as Record<string, unknown>;
+          reportUnknownStyleFields('a sample line', o, KNOWN_SAMPLE_FIELDS);
+          const line = text(o.line, 500);
+          if (!line) return null;
+          const read = text(o.read, 120);
+          return read ? { line, read } : { line };
+        })
+        .filter((s): s is WritingStyleSample => s !== null)
+        .slice(0, 8)
+    : [];
+  return { narrator: narrator ?? '', voice: voice ?? '', rules, sample };
+}
+
+/**
+ * Field by field, like every other payload of theirs, so a field they add cannot reach a browser
+ * unread and a missing one is `null` rather than `undefined` in a card.
+ *
+ * THE PREVIEW URL IS REBUILT FROM OUR BASE, not passed through. They mint it from the request's
+ * own protocol and host, and behind Railway's proxy that protocol can read `http` — a mixed-content
+ * video on our https page. The path is documented (`/api/v1/styles/:id/preview.mp4`) and public,
+ * so composing it from CONTENT_QUEEN_API_URL is both exact and always https in production.
+ */
+function normaliseStyle(raw: unknown, base: string): VideoStyleInfo | null {
+  if (!raw || typeof raw !== 'object') return null;
+  const s = raw as Record<string, unknown>;
+  reportUnknownStyleFields('a style', s, KNOWN_STYLE_FIELDS);
+  const id = text(s.id, 60);
+  if (!id || !/^[a-z0-9][a-z0-9-]*$/.test(id)) return null;
+  return {
+    id,
+    label: text(s.label, 80) ?? id,
+    default: s.default === true,
+    summary: text(s.summary, 600) ?? '',
+    bestFor: text(s.bestFor, 400) ?? '',
+    previewUrl: text(s.previewUrl, 1000) ? `${base}/api/v1/styles/${encodeURIComponent(id)}/preview.mp4` : null,
+    previewSeconds: finite(s.previewSeconds),
+    estimatedCostPerLessonUsd: finite(s.estimatedCostPerLessonUsd),
+    writingStyle: normaliseWritingStyle(s.writingStyle),
+  };
+}
+
+/** Exported for its test. */
+export function normaliseStyleList(raw: unknown, base: string = baseUrl()): VideoStyleList | null {
+  if (!raw || typeof raw !== 'object') return null;
+  const body = raw as Record<string, unknown>;
+  reportUnknownStyleFields('the style list', body, KNOWN_STYLE_LIST_FIELDS);
+  const styles = (Array.isArray(body.styles) ? body.styles : [])
+    .map((s) => normaliseStyle(s, base))
+    .filter((s): s is VideoStyleInfo => s !== null);
+  if (styles.length === 0) return null;
+  const declared = text(body.default, 60);
+  const defaultStyle = declared && styles.some((s) => s.id === declared)
+    ? declared
+    : styles.find((s) => s.default)?.id ?? styles[0]!.id;
+  return {
+    defaultStyle,
+    // Exactly one card is marked default, and it is the one `default` names.
+    styles: styles.map((s) => ({ ...s, default: s.id === defaultStyle })),
+  };
+}
+
+/**
+ * Five minutes. The list changes when they ship, not between two page loads, and every instructor
+ * opening either Build tab asks for it — so it is cached rather than proxied per view. A failed
+ * refresh serves the last good list: a picker showing yesterday's wording is better than none.
+ */
+const CACHE_MS = 5 * 60 * 1000;
+let cached: { at: number; data: VideoStyleList } | null = null;
+
+/** Test seam: the cache is module state. */
+export function resetStylesCache(): void {
+  cached = null;
+}
+
+/**
+ * Read their style list. FREE, public, and never throws.
+ *
+ * Not gated on CONTENT_QUEEN_JOBS_ENABLED: it spends nothing and needs no credential, and both
+ * forms that show it already explain when creation is switched off.
+ */
+export async function getStyles(): Promise<StylesResult> {
+  if (cached && Date.now() - cached.at < CACHE_MS) return { ok: true, data: cached.data };
+  const base = baseUrl();
+  try {
+    const res = await fetch(`${base}/api/v1/styles`, {
+      headers: { Accept: 'application/json' },
+      signal: AbortSignal.timeout(10_000),
+    });
+    if (!res.ok) {
+      console.warn(`[content-queen-styles] styles returned ${res.status}`);
+      return cached ? { ok: true, data: cached.data } : { ok: false, reason: 'unavailable' };
+    }
+    const list = normaliseStyleList(await res.json().catch(() => null), base);
+    if (!list) {
+      console.warn('[content-queen-styles] styles answer carried no usable style');
+      return cached ? { ok: true, data: cached.data } : { ok: false, reason: 'unavailable' };
+    }
+    cached = { at: Date.now(), data: list };
+    return { ok: true, data: list };
+  } catch (err) {
+    console.warn('[content-queen-styles] styles request failed:', err instanceof Error ? err.message : err);
+    return cached ? { ok: true, data: cached.data } : { ok: false, reason: 'unavailable' };
+  }
+}
+
+// ─── The motion-graphics plan rule, checked before money moves ──────────────────────────────────
+
+export interface PlanProblem {
+  /** Their path syntax, e.g. `modules[0].lessons[1].walkthroughs`. */
+  path: string;
+  message: string;
+}
+
+/**
+ * Their `planner.validate` motion branch, copied: every lesson names at least one model with a
+ * `name`, and walks through at least two situations with a `situation`. Their build answers
+ * `400 invalid_plan` otherwise — which arrives AFTER our ledger rows are written, so checking here
+ * is the difference between "fix this lesson" and "charged, then reversed".
+ *
+ * Returns [] for any other style. Never throws on a malformed plan.
+ */
+export function motionPlanErrors(plan: unknown): PlanProblem[] {
+  const p = plan as { modules?: unknown } | null;
+  if (!p || !Array.isArray(p.modules)) return [];
+  const str = (v: unknown) => typeof v === 'string' && v.trim().length > 0;
+  const out: PlanProblem[] = [];
+  for (const [mi, m] of p.modules.entries()) {
+    const lessons = (m as { lessons?: unknown } | null)?.lessons;
+    if (!Array.isArray(lessons)) continue;
+    for (const [li, l] of lessons.entries()) {
+      const lesson = (l ?? {}) as { title?: unknown; models?: unknown; walkthroughs?: unknown };
+      const at = `modules[${mi}].lessons[${li}]`;
+      const name = str(lesson.title) ? `"${String(lesson.title).trim()}"` : `Lesson ${li + 1} of module ${mi + 1}`;
+      const models = Array.isArray(lesson.models) ? lesson.models : [];
+      if (!models.some((x) => str((x as { name?: unknown } | null)?.name))) {
+        out.push({ path: `${at}.models`, message: `${name} needs at least one model (its name and author).` });
+      }
+      const walks = Array.isArray(lesson.walkthroughs) ? lesson.walkthroughs : [];
+      if (walks.filter((w) => str((w as { situation?: unknown } | null)?.situation)).length < 2) {
+        out.push({ path: `${at}.walkthroughs`, message: `${name} needs at least two walk-throughs, each with a situation.` });
+      }
+    }
+  }
+  return out;
+}
