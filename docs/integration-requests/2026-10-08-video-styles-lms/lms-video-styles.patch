+import { buildAuthoredPlan, buildCourse, lessonsOf, type CoursePlan } from '../../src/lib/content-queen-courses.js';
+import { createJob } from '../../src/lib/content-queen-jobs.js';
+
+function jsonResponse(body: unknown, status = 200) {
+  return { ok: status >= 200 && status < 300, status, json: async () => body } as unknown as Response;
+}
+
+let fetchMock: ReturnType<typeof vi.fn>;
+
+beforeEach(() => {
+  process.env.CONTENT_QUEEN_API_TOKEN = 'test-token-not-a-real-credential';
+  process.env.CONTENT_QUEEN_JOBS_ENABLED = 'true';
+  process.env.CONTENT_QUEEN_PRODUCE_ENABLED = 'true';
+  process.env.CONTENT_QUEEN_API_URL = 'https://cq.example';
+  fetchMock = vi.fn();
+  vi.stubGlobal('fetch', fetchMock);
+  resetStylesCache();
+});
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+  delete process.env.CONTENT_QUEEN_JOBS_ENABLED;
+  delete process.env.CONTENT_QUEEN_PRODUCE_ENABLED;
+  delete process.env.CONTENT_QUEEN_API_TOKEN;
+  delete process.env.CONTENT_QUEEN_API_URL;
+});
+
+const motionVideo = (over: Record<string, unknown> = {}) => ({
+  title: 'Your role as a buddy',
