+  });
+
+  it('refuses a lesson with no named model, naming the lesson', () => {
+    const r = buildAuthoredPlan({ topic: 't', description: '', style: 'motion-graphics', videos: [motionVideo({ models: [{ name: '  ' }] })] });
+    expect(r.ok).toBe(false);
+    if (!r.ok) expect(r.detail).toMatch(/Video 1 needs a model/);
+  });
+
+  it('refuses fewer than two walk-throughs with a situation', () => {
+    const r = buildAuthoredPlan({
+      topic: 't', description: '', style: 'motion-graphics',
+      videos: [motionVideo({ walkthroughs: [{ title: 'only one', situation: 's' }, { title: 'no situation', situation: '' }] })],
+    });
+    expect(r.ok).toBe(false);
+    if (!r.ok) expect(r.detail).toMatch(/two walk-throughs/);
+  });
+
+  it('refuses a course tag hidden in a walk-through, like one in a title', () => {
+    const r = buildAuthoredPlan({
+      topic: 't', description: '', style: 'motion-graphics',
+      videos: [motionVideo({ walkthroughs: [{ situation: 'see [course-abc123]' }, { situation: 'fine' }] })],
+    });
+    expect(r.ok).toBe(false);
+  });
+
+  it('ignores motion fields entirely in character-arc', () => {
+    const r = buildAuthoredPlan({ topic: 't', description: '', videos: [motionVideo()] });
+    expect(r.ok).toBe(true);
+    if (!r.ok) return;
+    expect(r.plan.style).toBe('character-arc');
+    expect(r.plan.slos).toBeUndefined();
+    expect(lessonsOf(r.plan)[0]!.models).toBeUndefined();
