+/**
+ * Unit — Content Automation video styles (contract 1.2, additive, 2026-10-08).
+ *
+ * Three things are pinned here, each because getting it wrong costs money or misfiles a course:
+ *
+ *   1. `style` is ALWAYS sent on plan, build and make-video — never left to their default.
+ *   2. A motion-graphics plan without a model and two walk-throughs per lesson is refused on OUR
+ *      side before anything is written (authored) or charged (build), with the lesson named.
+ *   3. Their `400 invalid_plan` / `invalid_style` on build is `invalid` — the reversible reason —
+ *      and carries their per-lesson messages, not just their summary sentence.
+ *
+ * `fetch` is mocked rather than the modules, as in content-queen-courses.test.ts.
+ */
+import { describe, it, expect, beforeEach, afterEach, vi } from 'vitest';
+import {
+  parseStyleInput,
+  normaliseStyleList,
+  motionPlanErrors,
+  getStyles,
