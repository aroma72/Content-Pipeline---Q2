    "verify": "node verify.js"
  },
  "dependencies": {
    "docx": "^8.5.0",
    "ffmpeg-static": "^5.3.0",
    "puppeteer": "^25.0.0"
  },
  "optionalDependencies": {
    "lottie-web": "^5.13.0"
  }
}
