.env
.DS_Store
node_modules/

# Rendered / generated video artifacts (regenerable, not committed)
art/
layers/
audio/
frames/
frames_bend/
out/
preview/
preview-lesson/
*.mp4
*.mov
*.webm
*.wav
*.mp3
*.gif

# keep brand assets (fonts/logo) — they are source, not artifacts
!brand-intro-outro/brand/**
