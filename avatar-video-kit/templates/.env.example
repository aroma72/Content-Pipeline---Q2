# ── Avatar Video Kit — environment keys ───────────────────────────────
# Copy this file to `.env` (in the project root or any PARENT folder) and fill in.
# The scripts walk up from the working dir to find a .env, so one shared .env
# at a parent folder covers every video sub-folder.

# kie.ai key — powers BOTH the still image (nano-banana-2) and the lip-sync
# (infinitalk). GEMINI_OMNI_API_KEY is the funded account; KIE_API_KEY is a
# fallback. Either one works; set at least one.
GEMINI_OMNI_API_KEY=
KIE_API_KEY=

# Google AI Studio key — powers the Gemini TTS voiceover.
# GEMINI_API_KEY wins if both are set; GOOGLE_STUDIO_API_KEY also accepted.
GEMINI_API_KEY=
GOOGLE_STUDIO_API_KEY=
