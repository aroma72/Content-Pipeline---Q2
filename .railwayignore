# What `railway up` must not upload. The repo carries gigabytes of rendered
# media, a virtualenv and Chrome profiles; without this the upload is enormous.
# The image's real contents are still governed by .dockerignore.
.git
node_modules
**/node_modules
venv
.venv
**/__pycache__
.pytest_cache
*.webm
*.mp4
*.mov
*.wav
*.mp3
*.aac
*.pptx
*.docx
# ...except the brand media the service serves itself: the video-style previews
# (GET /api/v1/styles/:id/preview.mp4) and the motion-graphics music bed (MUSIC_FILE). The
# first deploy with them shipped neither -- the previews answered 404 preview_missing and
# a motion-graphics render would have fallen back to synthesized music. .dockerignore
# already admits brand/**; this file must agree, or they never reach the build.
!explainer-videos/brand-intro-outro/brand/style-previews/*.mp4
!explainer-videos/brand-intro-outro/brand/*.mp3
explainer-videos/**/frames
explainer-videos/**/art
explainer-videos/**/clips
explainer-videos/**/audio
explainer-videos/**/out
explainer-videos/**/layers
explainer-videos/**/.chrome-profile
# Consolidated 2026-09-28: render output and the kits that produce it live under
# media/, authored + pipeline-state material under content/. Neither reaches the
# image (.dockerignore denies all but its allowlist), so neither needs uploading.
# Leading slash: anchored to the root, so a nested folder that happens to be
# called media/ or content/ still uploads.
/media
/content

# Output dirs that may still be written at the repo root by an ad-hoc run.
output
course-overview-assets
course-overview-test-output
voiceover-windows
.env
.env.*

# Legacy-era scripts and scratch, kept for history only. Never runs in the image
# (.dockerignore excludes it via the deny-all `*`), so it need not be uploaded.
/legacy
